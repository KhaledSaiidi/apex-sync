# This file is optional when all required values already exist in the process
# environment. bootstrap.sh also maps the TF_VAR_aws_* values below to the
# standard AWS variables used by the configured S3 backend.
export TF_VAR_github_app_id="xxxxxx"
export TF_VAR_github_app_installation_id="xxxxxx"
export TF_VAR_github_app_private_key="$(cat /path/to/argocd-github-app.pem)"
export TF_VAR_aws_access_key_id="AKxxxxxxxxxxxxxxxxx"
export TF_VAR_aws_secret_access_key="AKxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
